# Secrets — never commit a filled-in .env
.env

# Local state. The archive in archive/ is the durable record and IS committed;
# the database is a rebuildable cache, so it stays out of git. v1 committed it
# on every run, which is why this repository's history is 50 identical
# "Update news database" commits.
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated site (built in CI and published to Pages)
site/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
